{
  "name": "all-your-agents",
  "version": "1.0.0",
  "description": "Event-driven, harness-neutral API for live coding-agent sessions",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.types.json && node --test 'dist-test/test/**/*.test.js'",
    "lint": "biome check . && node scripts/check-no-interval.mjs"
  },
  "keywords": [
    "agents",
    "claude-code",
    "sessions"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2"
  },
  "optionalDependencies": {
    "koffi": "^2.14.1"
  }
}
